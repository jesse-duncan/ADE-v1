<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100 select-none">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Android 15 Virtual Machine & App Testing Suite</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            m3: {
              primary: '#A8C7FA',
              onPrimary: '#00315B',
              surface: '#111318',
              surfaceVariant: '#282A2F',
              primaryContainer: '#004A77',
              onPrimaryContainer: '#C2E7FF',
              accent: '#7C4DFF',
              card: 'rgba(30, 34, 42, 0.85)',
            }
          },
          fontFamily: {
            sans: ['Inter', 'Roboto', 'sans-serif'],
            mono: ['Fira Code', 'monospace'],
          },
          animation: {
            'pulse-fast': 'pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'bounce-short': 'bounce 0.5s infinite alternate',
          }
        }
      }
    }
  </script>

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    /* Custom scrollbars for simulated mobile UI & logs */
    ::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.2);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.2);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.4);
    }
    
    /* Device frame glass reflections */
    .device-screen-shadow {
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 30px 2px rgba(124, 77, 255, 0.15);
    }
    
    .glossy-overlay {
      background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 40%);
    }

    /* Swipe gesture bar styling */
    .gesture-bar {
      width: 120px;
      height: 4px;
      background-color: rgba(255, 255, 255, 0.6);
      border-radius: 9999px;
    }

    /* Material You Ripple & Glass Effects */
    .m3-glass {
      background: rgba(28, 32, 40, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* App Active Card Stack in Recents */
    .recents-card {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
  </style>
</head>
<body class="h-full w-full flex flex-col bg-slate-950 font-sans overflow-hidden text-slate-100">

  <!-- Top Workspace Toolbar & VM Control Panel -->
  <header class="h-14 border-b border-slate-800 bg-slate-900/90 px-4 flex items-center justify-between z-30 shrink-0">
    <div class="flex items-center space-x-3">
      <div class="flex items-center space-x-2 text-indigo-400 font-bold text-lg">
        <i class="fa-brands fa-android text-2xl text-emerald-400 animate-pulse"></i>
        <span>Android 15 <span class="text-xs bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 px-2 py-0.5 rounded-full font-mono">API 35</span></span>
      </div>
      <span class="text-slate-600">|</span>
      <span class="text-xs text-slate-400 hidden md:inline-block">Pixel 9 Pro WebAssembly VM Sandbox</span>
    </div>

    <!-- Live VM Hardware Metrics Display -->
    <div class="hidden lg:flex items-center space-x-6 text-xs font-mono bg-slate-950 px-4 py-1.5 rounded-xl border border-slate-800/80">
      <div class="flex items-center space-x-2">
        <span class="text-slate-500">FPS:</span>
        <span id="metric-fps" class="text-emerald-400 font-semibold">60</span>
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-slate-500">CPU:</span>
        <div class="w-12 bg-slate-800 rounded-full h-1.5 overflow-hidden">
          <div id="metric-cpu-bar" class="bg-indigo-400 h-full w-12 transition-all duration-300"></div>
        </div>
        <span id="metric-cpu-text" class="text-indigo-300">12%</span>
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-slate-500">RAM:</span>
        <span id="metric-ram" class="text-sky-400 font-semibold">3.2 / 12 GB</span>
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-slate-500">NET:</span>
        <span id="metric-net-status" class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1 animate-ping"></span> ONLINE
        </span>
      </div>
    </div>

    <!-- Action Toolbar Controls -->
    <div class="flex items-center space-x-2">
      <button id="btn-toggle-net" onclick="VM.toggleNetwork()" title="Toggle Virtual Wi-Fi (Online/Offline)" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs flex items-center space-x-1.5 border border-slate-700 transition">
        <i id="net-icon" class="fa-solid fa-wifi text-emerald-400"></i>
        <span class="hidden sm:inline">Network</span>
      </button>

      <button onclick="VM.takeScreenshot()" title="Take Virtual Device Screenshot" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs flex items-center space-x-1.5 border border-slate-700 transition">
        <i class="fa-solid fa-camera text-sky-400"></i>
        <span class="hidden sm:inline">Capture</span>
      </button>

      <button onclick="VM.rotateDevice()" title="Rotate Device" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs flex items-center space-x-1.5 border border-slate-700 transition">
        <i class="fa-solid fa-rotate text-purple-400"></i>
        <span class="hidden sm:inline">Rotate</span>
      </button>

      <button id="btn-power" onclick="VM.togglePower()" title="Power On/Off Device" class="p-2 rounded-lg bg-red-950/50 hover:bg-red-900/60 text-red-300 text-xs flex items-center space-x-1.5 border border-red-800/50 transition">
        <i class="fa-solid fa-power-off"></i>
        <span class="hidden sm:inline">Power</span>
      </button>

      <button onclick="VM.toggleConsole()" title="Toggle Logcat Terminal" class="p-2 rounded-lg bg-indigo-900/40 hover:bg-indigo-800/60 text-indigo-300 text-xs flex items-center space-x-1.5 border border-indigo-700/50 transition">
        <i class="fa-solid fa-terminal"></i>
        <span class="hidden sm:inline">Logcat</span>
      </button>
    </div>
  </header>

  <!-- Main Workspace Area -->
  <main class="flex-1 relative flex items-center justify-center p-3 sm:p-6 overflow-hidden bg-slate-950/60">
    <!-- Grid Background FX -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>

    <!-- Phone Chassis Frame -->
    <div id="device-container" class="relative transition-all duration-500 ease-in-out flex flex-col items-center justify-center">
      
      <!-- Outer Smartphone Body -->
      <div id="phone-chassis" class="relative w-[380px] h-[780px] max-h-[88vh] bg-slate-900 rounded-[48px] p-3.5 border-4 border-slate-700/80 device-screen-shadow transition-all duration-300 flex flex-col">
        
        <!-- Physical Side Buttons (Aesthetic) -->
        <div onclick="VM.volumeStep(1)" class="absolute -left-2.5 top-28 w-1.5 h-12 bg-slate-700 rounded-l-md cursor-pointer hover:bg-slate-500 transition" title="Volume Up"></div>
        <div onclick="VM.volumeStep(-1)" class="absolute -left-2.5 top-44 w-1.5 h-12 bg-slate-700 rounded-l-md cursor-pointer hover:bg-slate-500 transition" title="Volume Down"></div>
        <div onclick="VM.togglePower()" class="absolute -right-2.5 top-32 w-1.5 h-16 bg-slate-700 rounded-r-md cursor-pointer hover:bg-red-500 transition" title="Power Button"></div>

        <!-- Inner Bezel Display Wrapper -->
        <div class="relative w-full h-full bg-slate-950 rounded-[38px] overflow-hidden flex flex-col border border-slate-800/80 shadow-inner">
          
          <!-- Gloss Reflection Layer -->
          <div class="absolute inset-0 glossy-overlay pointer-events-none z-30"></div>

          <!-- Camera Punch-Hole & Earpiece Speaker -->
          <div class="absolute top-2 left-1/2 -translate-x-1/2 z-40 flex flex-col items-center pointer-events-none">
            <div class="w-12 h-1 bg-slate-800 rounded-full mb-1"></div>
            <div class="w-4 h-4 bg-black rounded-full border border-slate-800 flex items-center justify-center">
              <div class="w-1.5 h-1.5 bg-slate-900 rounded-full"></div>
            </div>
          </div>

          <!-- Android Status Bar -->
          <div id="status-bar" onclick="VM.toggleQuickSettings()" class="h-8 px-6 pt-1.5 flex justify-between items-center text-xs font-medium text-slate-200 z-30 cursor-pointer hover:bg-white/5 transition">
            <span id="clock" class="font-semibold text-[11px] tracking-wide">12:00</span>
            <div class="flex items-center space-x-2 text-[11px]">
              <i id="status-wifi-icon" class="fa-solid fa-wifi text-emerald-400"></i>
              <i class="fa-solid fa-signal text-slate-300"></i>
              <div class="flex items-center space-x-1">
                <span id="battery-level" class="text-[10px]">88%</span>
                <i id="battery-icon" class="fa-solid fa-battery-three-quarters text-emerald-400"></i>
              </div>
            </div>
          </div>

          <!-- Quick Settings Dropdown Overlay -->
          <div id="quick-settings" class="absolute inset-x-0 top-0 h-80 bg-slate-900/95 backdrop-blur-xl z-40 -translate-y-full transition-transform duration-300 border-b border-slate-700 p-5 flex flex-col justify-between shadow-2xl">
            <div class="flex justify-between items-center text-slate-400 text-xs">
              <span id="qs-date">Monday, Sep 28</span>
              <div class="flex space-x-3 text-sm text-slate-200">
                <i class="fa-solid fa-user-gear cursor-pointer hover:text-indigo-400" onclick="VM.openApp('settings')"></i>
                <i class="fa-solid fa-power-off cursor-pointer hover:text-red-400" onclick="VM.togglePower()"></i>
              </div>
            </div>

            <!-- Quick Tiles Grid -->
            <div class="grid grid-cols-2 gap-3 my-auto">
              <button onclick="VM.toggleNetwork()" class="m3-glass p-3 rounded-2xl flex items-center space-x-3 hover:bg-slate-800 transition">
                <div id="qs-wifi-bg" class="w-9 h-9 rounded-full bg-indigo-500 text-white flex items-center justify-center">
                  <i class="fa-solid fa-wifi"></i>
                </div>
                <div class="text-left">
                  <div class="text-xs font-semibold text-slate-100">Internet</div>
                  <div id="qs-wifi-sub" class="text-[10px] text-indigo-300">Android-VM-5G</div>
                </div>
              </button>

              <button onclick="VM.toggleBluetooth()" class="m3-glass p-3 rounded-2xl flex items-center space-x-3 hover:bg-slate-800 transition">
                <div id="qs-bt-bg" class="w-9 h-9 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center">
                  <i class="fa-solid fa-bluetooth"></i>
                </div>
                <div class="text-left">
                  <div class="text-xs font-semibold text-slate-100">Bluetooth</div>
                  <div id="qs-bt-sub" class="text-[10px] text-slate-400">Off</div>
                </div>
              </button>

              <button onclick="VM.toggleDarkMode()" class="m3-glass p-3 rounded-2xl flex items-center space-x-3 hover:bg-slate-800 transition">
                <div class="w-9 h-9 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center">
                  <i class="fa-solid fa-moon"></i>
                </div>
                <div class="text-left">
                  <div class="text-xs font-semibold text-slate-100">Dark Theme</div>
                  <div class="text-[10px] text-indigo-300">Active</div>
                </div>
              </button>

              <button onclick="VM.showToast('Do Not Disturb enabled')" class="m3-glass p-3 rounded-2xl flex items-center space-x-3 hover:bg-slate-800 transition">
                <div class="w-9 h-9 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center">
                  <i class="fa-solid fa-minus-circle"></i>
                </div>
                <div class="text-left">
                  <div class="text-xs font-semibold text-slate-100">Do Not Disturb</div>
                  <div class="text-[10px] text-slate-400">Off</div>
                </div>
              </button>
            </div>

            <!-- Volume / Brightness Sliders -->
            <div class="space-y-2">
              <div class="flex items-center space-x-3 text-xs text-slate-300">
                <i class="fa-solid fa-volume-high"></i>
                <input type="range" id="volume-slider" min="0" max="100" value="80" oninput="VM.setVolume(this.value)" class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-indigo-400">
              </div>
            </div>

            <div class="text-center pt-1" onclick="VM.toggleQuickSettings()">
              <i class="fa-solid fa-chevron-up text-slate-500 text-xs hover:text-slate-300 cursor-pointer"></i>
            </div>
          </div>

          <!-- Power Off Black Screen overlay -->
          <div id="power-screen" class="absolute inset-0 bg-black z-50 flex items-center justify-center hidden">
            <span class="text-xs text-slate-600 font-mono">Device Power Off</span>
          </div>

          <!-- Lock Screen View -->
          <div id="lock-screen" class="absolute inset-0 z-20 bg-gradient-to-b from-indigo-950 via-slate-900 to-black flex flex-col justify-between p-8 text-center">
            <div class="mt-12">
              <div id="lock-clock" class="text-6xl font-light tracking-tighter text-indigo-200">12:00</div>
              <div id="lock-date" class="text-sm font-medium text-indigo-300/80 mt-1">Monday, September 28</div>
            </div>

            <div class="mb-12 flex flex-col items-center space-y-4">
              <button onclick="VM.unlockDevice()" class="w-14 h-14 rounded-full bg-indigo-500/20 border border-indigo-400/40 text-indigo-300 flex items-center justify-center animate-bounce">
                <i class="fa-solid fa-lock-open text-lg"></i>
              </button>
              <span class="text-xs text-slate-400">Click or Swipe up to unlock</span>
            </div>
          </div>

          <!-- Main OS Viewport Container -->
          <div id="os-viewport" class="relative flex-1 bg-slate-950 overflow-hidden flex flex-col">
            
            <!-- Toast Banner Container -->
            <div id="toast-container" class="absolute top-2 inset-x-3 z-50 pointer-events-none flex flex-col items-center space-y-2"></div>

            <!-- Home Screen View -->
            <div id="home-screen" class="absolute inset-0 flex flex-col justify-between p-5 overflow-y-auto bg-gradient-to-b from-slate-900 via-indigo-950/40 to-slate-950">
              
              <!-- Material You Weather / Clock Widget -->
              <div class="mt-2 p-4 rounded-3xl m3-glass flex items-center justify-between border border-white/10 shadow-lg">
                <div>
                  <div class="text-2xl font-bold text-slate-100" id="widget-temp">72°F</div>
                  <div class="text-xs text-slate-400 flex items-center space-x-1">
                    <i class="fa-solid fa-location-dot text-indigo-400"></i>
                    <span>Mountain View, CA</span>
                  </div>
                </div>
                <div class="text-right">
                  <i class="fa-solid fa-cloud-sun text-amber-400 text-3xl"></i>
                  <div class="text-[10px] text-slate-400 mt-1">Sunny & Clear</div>
                </div>
              </div>

              <!-- Material Search Bar -->
              <div class="my-4 px-4 py-3 rounded-full m3-glass flex items-center space-x-3 text-slate-300 cursor-pointer shadow-md border border-white/10 hover:bg-slate-800/80 transition" onclick="VM.openApp('browser')">
                <i class="fa-brands fa-google text-indigo-400 text-lg"></i>
                <span class="text-xs text-slate-400 flex-1">Search or type URL...</span>
                <i class="fa-solid fa-microphone text-slate-400 text-xs"></i>
              </div>

              <!-- Launcher App Icons Grid -->
              <div class="grid grid-cols-4 gap-4 my-auto" id="app-grid">
                <!-- Dynamic App Icons injected here -->
              </div>

              <!-- Fixed Bottom Dock -->
              <div class="mt-auto px-4 py-3 rounded-3xl m3-glass flex justify-around items-center border border-white/10 shadow-2xl">
                <button onclick="VM.openApp('browser')" class="flex flex-col items-center group">
                  <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-500 text-white flex items-center justify-center text-lg shadow-lg group-hover:scale-105 transition">
                    <i class="fa-solid fa-globe"></i>
                  </div>
                </button>
                <button onclick="VM.openApp('connectivity')" class="flex flex-col items-center group">
                  <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center text-lg shadow-lg group-hover:scale-105 transition">
                    <i class="fa-solid fa-bolt"></i>
                  </div>
                </button>
                <button onclick="VM.openApp('playstore')" class="flex flex-col items-center group">
                  <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-sky-500 to-blue-600 text-white flex items-center justify-center text-lg shadow-lg group-hover:scale-105 transition">
                    <i class="fa-solid fa-bag-shopping"></i>
                  </div>
                </button>
                <button onclick="VM.openApp('runner')" class="flex flex-col items-center group">
                  <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-purple-600 to-pink-500 text-white flex items-center justify-center text-lg shadow-lg group-hover:scale-105 transition">
                    <i class="fa-solid fa-box-open"></i>
                  </div>
                </button>
              </div>
            </div>

            <!-- Active App Container Overlay -->
            <div id="app-window" class="absolute inset-0 bg-slate-900 z-10 hidden flex-col">
              <!-- App Title Header Bar -->
              <div class="h-10 border-b border-slate-800 bg-slate-950 px-4 flex items-center justify-between text-xs font-semibold text-slate-300">
                <div class="flex items-center space-x-2">
                  <i id="app-window-icon" class="fa-solid fa-cube text-indigo-400"></i>
                  <span id="app-window-title">App Name</span>
                </div>
                <div class="flex items-center space-x-2">
                  <button onclick="VM.closeCurrentApp()" class="text-slate-400 hover:text-slate-100 p-1">
                    <i class="fa-solid fa-xmark"></i>
                  </button>
                </div>
              </div>

              <!-- App Content Body (Dynamic) -->
              <div id="app-body" class="flex-1 overflow-y-auto relative bg-slate-900">
                
                <!-- APP 1: Google Play Store View -->
                <div id="view-playstore" class="app-view hidden p-4 space-y-4">
                  <div class="flex items-center space-x-2 bg-slate-800 rounded-xl px-3 py-2 border border-slate-700">
                    <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs"></i>
                    <input type="text" placeholder="Search Google Play apps..." class="bg-transparent border-none text-xs text-slate-200 outline-none w-full" />
                  </div>

                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Featured Android Apps</h3>

                  <div id="playstore-list" class="space-y-3">
                    <!-- Dynamic store items -->
                  </div>
                </div>

                <!-- APP 2: Chrome Web Browser View -->
                <div id="view-browser" class="app-view hidden flex flex-col h-full">
                  <div class="p-2 border-b border-slate-800 bg-slate-950 flex items-center space-x-2">
                    <input id="browser-url" type="text" value="https://httpbin.org/get" class="flex-1 bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-xs font-mono text-slate-200 outline-none focus:border-indigo-500">
                    <button onclick="VM.browserNavigate()" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-medium">Go</button>
                  </div>
                  <div class="flex-1 relative bg-white">
                    <iframe id="browser-iframe" class="w-full h-full border-none" src="about:blank"></iframe>
                    <div id="browser-fallback" class="absolute inset-0 bg-slate-900 p-4 text-xs font-mono text-slate-300 overflow-auto hidden">
                      <div class="text-emerald-400 mb-2">// Network Inspection / Response Mirror</div>
                      <pre id="browser-response-data">Loading...</pre>
                    </div>
                  </div>
                </div>

                <!-- APP 3: App Connectivity Tester Suite -->
                <div id="view-connectivity" class="app-view hidden p-4 space-y-4">
                  <div class="border-b border-slate-800 pb-2">
                    <h2 class="text-sm font-bold text-slate-100 flex items-center space-x-2">
                      <i class="fa-solid fa-network-wired text-emerald-400"></i>
                      <span>Android Network Diagnostics</span>
                    </h2>
                    <p class="text-[11px] text-slate-400">Test live network protocols & latency within emulated sandbox.</p>
                  </div>

                  <div class="grid grid-cols-2 gap-2">
                    <button onclick="VM.testApiEndpoint('ip')" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-left transition">
                      <div class="text-xs font-semibold text-sky-400">Public IP Test</div>
                      <div class="text-[10px] text-slate-400">api.ipify.org</div>
                    </button>
                    <button onclick="VM.testApiEndpoint('json')" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-left transition">
                      <div class="text-xs font-semibold text-emerald-400">REST API Test</div>
                      <div class="text-[10px] text-slate-400">jsonplaceholder GET</div>
                    </button>
                    <button onclick="VM.testApiEndpoint('echo')" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-left transition">
                      <div class="text-xs font-semibold text-purple-400">HTTP Echo POST</div>
                      <div class="text-[10px] text-slate-400">httpbin.org/post</div>
                    </button>
                    <button onclick="VM.testApiEndpoint('ping')" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-left transition">
                      <div class="text-xs font-semibold text-amber-400">Latency Check</div>
                      <div class="text-[10px] text-slate-400">Measure RTT Ping</div>
                    </button>
                  </div>

                  <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 font-mono text-[11px] space-y-2">
                    <div class="flex justify-between items-center text-slate-400">
                      <span>Status Output</span>
                      <span id="conn-latency" class="text-emerald-400">0 ms</span>
                    </div>
                    <pre id="conn-result" class="text-slate-300 max-h-40 overflow-auto whitespace-pre-wrap break-all">Ready for diagnostic test...</pre>
                  </div>
                </div>

                <!-- APP 4: Custom APK / Web App Runner -->
                <div id="view-runner" class="app-view hidden p-4 space-y-4">
                  <div class="border-b border-slate-800 pb-2">
                    <h2 class="text-sm font-bold text-slate-100 flex items-center space-x-2">
                      <i class="fa-solid fa-code text-purple-400"></i>
                      <span>APK & Custom Web App Deployment</span>
                    </h2>
