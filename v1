  <!-- Slide-up Logcat / Debug Console Drawer -->
  <div id="console-drawer" class="fixed bottom-0 inset-x-0 h-64 bg-slate-950 border-t border-slate-800 flex flex-col z-50 transform translate-y-full transition-transform duration-300 font-mono text-xs shadow-2xl">
    <div class="h-9 bg-slate-900 border-b border-slate-800 px-4 flex items-center justify-between text-slate-300">
      <div class="flex items-center space-x-3">
        <span class="font-bold text-indigo-400 flex items-center space-x-1.5">
          <i class="fa-solid fa-terminal"></i>
          <span>Android Logcat & Network Sniffer</span>
        </span>
        <span id="log-count" class="bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full text-[10px]">0 logs</span>
      </div>

      <div class="flex items-center space-x-3">
        <button onclick="VM.clearLogs()" class="text-slate-400 hover:text-slate-200 text-xs">Clear</button>
        <button onclick="VM.toggleConsole()" class="text-slate-400 hover:text-slate-200 text-xs">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>

    <!-- Log List -->
    <div id="logcat-output" class="flex-1 overflow-y-auto p-3 space-y-1 bg-slate-950 text-slate-300 select-text font-mono text-[11px]">
      <!-- Dynamic Logs -->
    </div>
  </div>

  <script>
    /**
     * Android 15 Virtual Machine Engine & Sandbox Manager
     */
    class AndroidVM {
      constructor() {
        this.isPowered = true;
        this.isLocked = false;
        this.isOnline = true;
        this.isBluetooth = false;
        this.isRotated = false;
        this.volume = 80;
        this.currentApp = null;
        this.appHistory = [];
        this.installedApps = [
          { id: 'playstore', name: 'Play Store', icon: 'fa-bag-shopping', bg: 'bg-gradient-to-tr from-sky-500 to-blue-600', system: true },
          { id: 'browser', name: 'Chrome', icon: 'fa-globe', bg: 'bg-gradient-to-tr from-blue-600 to-indigo-500', system: true },
          { id: 'connectivity', name: 'Net Tester', icon: 'fa-bolt', bg: 'bg-gradient-to-tr from-emerald-600 to-teal-500', system: true },
          { id: 'runner', name: 'APK Runner', icon: 'fa-box-open', bg: 'bg-gradient-to-tr from-purple-600 to-pink-500', system: true },
          { id: 'settings', name: 'Settings', icon: 'fa-gear', bg: 'bg-slate-700', system: true }
        ];

        this.storeCatalog = [
          { id: 'app_calculator', name: 'Scientific Calc', category: 'Utility', icon: 'fa-calculator', installed: false, desc: 'Quick math and scientific calculator.' },
          { id: 'app_crypto', name: 'Crypto Monitor', category: 'Finance', icon: 'fa-chart-line', installed: false, desc: 'Real-time crypto asset tracker.' },
          { id: 'app_snake', name: 'Retro Snake Game', category: 'Games', icon: 'fa-gamepad', installed: false, desc: 'Classic snake arcade game.' }
        ];

        this.audioCtx = null;
        this.fpsCounter = 60;
        this.cpuUsage = 12;
      }

      init() {
        this.initAudio();
        this.startClock();
        this.startMetricsLoop();
        this.renderAppGrid();
        this.renderPlayStore();
        this.log('SYSTEM', 'Android 15 Kernel 6.6 initialized successfully [API 35].', 'info');
        this.log('VM', 'Virtual WebAssembly runtime bridge connected.', 'info');
      }

      initAudio() {
        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) {
            this.audioCtx = new AudioContext();
          }
        } catch (e) {
          console.warn('AudioContext not supported');
        }
      }

      playAudioTone(freq = 440, duration = 0.05) {
        if (!this.audioCtx) return;
        try {
          if (this.audioCtx.state === 'suspended') {
            this.audioCtx.resume();
          }
          const osc = this.audioCtx.createOscillator();
          const gain = this.audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, this.audioCtx.currentTime);
          gain.gain.setValueAtTime(0.05, this.audioCtx.currentTime);
          osc.connect(gain);
          gain.connect(this.audioCtx.destination);
          osc.start();
          osc.stop(this.audioCtx.currentTime + duration);
        } catch (e) {}
      }

      startClock() {
        const update = () => {
          const now = new Date();
          const hours = String(now.getHours()).padStart(2, '0');
          const mins = String(now.getMinutes()).padStart(2, '0');
          const timeStr = `${hours}:${mins}`;
          
          document.getElementById('clock').textContent = timeStr;
          document.getElementById('lock-clock').textContent = timeStr;

          const options = { weekday: 'long', month: 'short', day: 'numeric' };
          const dateStr = now.toLocaleDateString('en-US', options);
          document.getElementById('lock-date').textContent = dateStr;
          document.getElementById('qs-date').textContent = dateStr;
        };
        update();
        setInterval(update, 1000);
      }

      startMetricsLoop() {
        setInterval(() => {
          // Simulate dynamic CPU fluctuations
          const cpuDelta = (Math.random() * 8) - 4;
          this.cpuUsage = Math.min(Math.max(Math.round(this.cpuUsage + cpuDelta), 5), 85);
          
          document.getElementById('metric-cpu-text').textContent = `${this.cpuUsage}%`;
          document.getElementById('metric-cpu-bar').style.width = `${this.cpuUsage}%`;

          // Random slight FPS variance for realism
          const fps = Math.floor(58 + Math.random() * 3);
          document.getElementById('metric-fps').textContent = fps;
        }, 2000);
      }

      log(tag, message, level = 'info') {
        const output = document.getElementById('logcat-output');
        const countBadge = document.getElementById('log-count');
        
        const timestamp = new Date().toISOString().split('T')[1].slice(0, 12);
        const logEntry = document.createElement('div');
        logEntry.className = 'flex space-x-2 border-b border-slate-900/50 py-0.5';

        let levelClass = 'text-slate-400';
        if (level === 'warn') levelClass = 'text-amber-400';
        if (level === 'error') levelClass = 'text-red-400';
        if (level === 'net') levelClass = 'text-emerald-400';

        logEntry.innerHTML = `
          <span class="text-slate-600">${timestamp}</span>
          <span class="font-bold ${levelClass}">[${tag}]</span>
          <span class="text-slate-200 flex-1 break-all">${message}</span>
        `;

        output.appendChild(logEntry);
        output.scrollTop = output.scrollHeight;

        const currentCount = output.children.length;
        countBadge.textContent = `${currentCount} logs`;
      }

      clearLogs() {
        document.getElementById('logcat-output').innerHTML = '';
        document.getElementById('log-count').textContent = '0 logs';
      }

      showToast(msg) {
        this.playAudioTone(520, 0.08);
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = 'm3-glass px-4 py-2 rounded-full text-xs font-medium text-slate-100 border border-slate-700 shadow-xl transition-all duration-300 transform translate-y-0 opacity-100 flex items-center space-x-2 pointer-events-auto';
        toast.innerHTML = `<i class="fa-solid fa-circle-info text-indigo-400 text-xs"></i><span>${msg}</span>`;
        
        container.appendChild(toast);
        setTimeout(() => {
          toast.classList.add('opacity-0', '-translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 2500);
      }

      toggleQuickSettings() {
        const qs = document.getElementById('quick-settings');
        const isOpen = !qs.classList.contains('-translate-y-full');
        if (isOpen) {
          qs.classList.add('-translate-y-full');
        } else {
          qs.classList.remove('-translate-y-full');
          this.log('SYSTEM', 'Quick Settings shade opened.', 'info');
        }
      }

      togglePower() {
        this.isPowered = !this.isPowered;
        const powerScreen = document.getElementById('power-screen');
        if (!this.isPowered) {
          powerScreen.classList.remove('hidden');
          this.log('SYSTEM', 'Device powered down.', 'warn');
          this.showToast('Device powered off');
        } else {
          powerScreen.classList.add('hidden');
          this.log('SYSTEM', 'Device booted into Android 15.', 'info');
          this.showToast('Android 15 Ready');
        }
      }

      toggleNetwork() {
        this.isOnline = !this.isOnline;
        const icon = document.getElementById('net-icon');
        const statusIcon = document.getElementById('status-wifi-icon');
        const metricNet = document.getElementById('metric-net-status');
        const qsBg = document.getElementById('qs-wifi-bg');
        const qsSub = document.getElementById('qs-wifi-sub');

        if (this.isOnline) {
          icon.className = 'fa-solid fa-wifi text-emerald-400';
          statusIcon.className = 'fa-solid fa-wifi text-emerald-400';
          metricNet.className = 'inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
          metricNet.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1 animate-ping"></span> ONLINE`;
          qsBg.className = 'w-9 h-9 rounded-full bg-indigo-500 text-white flex items-center justify-center';
          qsSub.textContent = 'Android-VM-5G';
          this.showToast('Wi-Fi Connected');
          this.log('NET', 'Virtual Wi-Fi adapter interface UP.', 'net');
        } else {
          icon.className = 'fa-solid fa-wifi-slash text-red-400';
          statusIcon.className = 'fa-solid fa-wifi-slash text-slate-500';
          metricNet.className = 'inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-red-500/10 text-red-400 border border-red-500/20';
          metricNet.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-red-400 mr-1"></span> OFFLINE`;
          qsBg.className = 'w-9 h-9 rounded-full bg-slate-800 text-slate-500 flex items-center justify-center';
          qsSub.textContent = 'Disconnected';
          this.showToast('Wi-Fi Disconnected');
          this.log('NET', 'Virtual Wi-Fi adapter interface DOWN.', 'warn');
        }
      }

      toggleBluetooth() {
        this.isBluetooth = !this.isBluetooth;
        const qsBg = document.getElementById('qs-bt-bg');
        const qsSub = document.getElementById('qs-bt-sub');
        if (this.isBluetooth) {
          qsBg.className = 'w-9 h-9 rounded-full bg-indigo-500 text-white flex items-center justify-center';
          qsSub.textContent = 'On';
          this.showToast('Bluetooth Turned On');
        } else {
          qsBg.className = 'w-9 h-9 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center';
          qsSub.textContent = 'Off';
          this.showToast('Bluetooth Off');
        }
      }

      volumeStep(delta) {
        this.volume = Math.min(Math.max(this.volume + delta * 10, 0), 100);
        document.getElementById('volume-slider').value = this.volume;
        this.showToast(`Volume: ${this.volume}%`);
        this.playAudioTone(300 + this.volume * 3, 0.04);
      }

      setVolume(val) {
        this.volume = val;
      }

      rotateDevice() {
        this.isRotated = !this.isRotated;
        const chassis = document.getElementById('phone-chassis');
        if (this.isRotated) {
          chassis.style.transform = 'rotate(-90deg) scale(0.85)';
          this.showToast('Landscape Mode');
        } else {
          chassis.style.transform = 'none';
          this.showToast('Portrait Mode');
        }
        this.log('SYSTEM', `Display rotated: landscape = ${this.isRotated}`, 'info');
      }

      takeScreenshot() {
        this.playAudioTone(800, 0.1);
        this.showToast('Screenshot Captured!');
        this.log('SYSTEM', 'Virtual Framebuffer Screenshot saved.', 'info');
      }

      unlockDevice() {
        this.playAudioTone(600, 0.05);
        document.getElementById('lock-screen').classList.add('hidden');
        this.isLocked = false;
        this.log('SYSTEM', 'Device unlocked by user.', 'info');
      }

      toggleConsole() {
        const drawer = document.getElementById('console-drawer');
        drawer.classList.toggle('translate-y-full');
      }

      renderAppGrid() {
        const grid = document.getElementById('app-grid');
        grid.innerHTML = '';

        this.installedApps.forEach(app => {
          const btn = document.createElement('button');
          btn.onclick = () => this.openApp(app.id);
          btn.className = 'flex flex-col items-center group space-y-1.5';
          btn.innerHTML = `
            <div class="w-12 h-12 rounded-2xl ${app.bg} text-white flex items-center justify-center text-xl shadow-lg group-hover:scale-105 transition">
              <i class="fa-solid ${app.icon}"></i>
            </div>
            <span class="text-[10px] text-slate-200 font-medium truncate w-14 text-center">${app.name}</span>
          `;
          grid.appendChild(btn);
        });
      }

      renderPlayStore() {
        const container = document.getElementById('playstore-list');
        container.innerHTML = '';

        this.storeCatalog.forEach(app => {
          const card = document.createElement('div');
          card.className = 'p-3 rounded-xl bg-slate-800/80 border border-slate-700 flex items-center justify-between';
          card.innerHTML = `
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-xl bg-indigo-600/30 text-indigo-400 border border-indigo-500/30 flex items-center justify-center text-lg">
                <i class="fa-solid ${app.icon}"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-100">${app.name}</div>
                <div class="text-[10px] text-slate-400">${app.desc}</div>
              </div>
            </div>
            <button id="btn-install-${app.id}" onclick="VM.installApp('${app.id}')" class="px-3 py-1.5 rounded-lg ${app.installed ? 'bg-slate-700 text-slate-300' : 'bg-indigo-600 hover:bg-indigo-500 text-white'} text-xs font-semibold transition">
              ${app.installed ? 'Installed' : 'Install'}
            </button>
          `;
          container.appendChild(card);
        });
      }

      installApp(appId) {
        const app = this.storeCatalog.find(a => a.id === appId);
        if (!app) return;

        if (app.installed) {
          this.openApp(app.id);
          return;
        }

        const btn = document.getElementById(`btn-install-${appId}`);
        btn.disabled = true;
        btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i>`;
        this.log('PLAYSTORE', `Downloading package: ${app.name}...`, 'info');

        setTimeout(() => {
          app.installed = true;
          this.installedApps.push({
            id: app.id,
            name: app.name,
            icon: app.icon,
            bg: 'bg-gradient-to-tr from-indigo-600 to-purple-600',
            system: false
          });

          this.renderAppGrid();
          this.renderPlayStore();
          this.playAudioTone(880, 0.12);
          this.showToast(`${app.name} Installed!`);
          this.log('PLAYSTORE', `Package ${app.name} installed successfully.`, 'info');
        }, 1500);
      }

      openApp(appId) {
        this.playAudioTone(450, 0.04);
        const windowEl = document.getElementById('app-window');
        const appTitle = document.getElementById('app-window-title');
        const appIcon = document.getElementById('app-window-icon');

        // Close active view overlays
        document.querySelectorAll('.app-view').forEach(v => v.classList.add('hidden'));

        const installed = this.installedApps.find(a => a.id === appId);
        const name = installed ? installed.name : 'Application';

        appTitle.textContent = name;
        if (installed) appIcon.className = `fa-solid ${installed.icon} text-indigo-400`;

        windowEl.classList.remove('hidden');
        windowEl.classList.add('flex');

        let targetView = document.getElementById(`view-${appId}`);
        if (!targetView) {
          targetView = document.getElementById('view-custom-container');
          this.loadCustomAppView(appId);
        }
        targetView.classList.remove('hidden');

        this.currentApp = appId;
        if (!this.appHistory.includes(appId)) {
          this.appHistory.push(appId);
        }

        this.log('ACTIVITY', `Displayed activity: ${appId}`, 'info');
      }

      closeCurrentApp() {
        const windowEl = document.getElementById('app-window');
        windowEl.classList.add('hidden');
        windowEl.classList.remove('flex');
        this.currentApp = null;
      }

      goHome() {
        document.getElementById('recents-screen').classList.add('hidden');
        document.getElementById('quick-settings').classList.add('-translate-y-full');
        this.closeCurrentApp();
        this.log('SYSTEM', 'Home gesture triggered.', 'info');
      }

      navBack() {
        if (this.currentApp) {
          this.closeCurrentApp();
        } else {
          this.showToast('Already on Home Screen');
        }
      }

      toggleRecents() {
        const recentsScreen = document.getElementById('recents-screen');
        const isHidden = recentsScreen.classList.contains('hidden');

        if (isHidden) {
          this.renderRecentsStack();
          recentsScreen.classList.remove('hidden');
          recentsScreen.classList.add('flex');
        } else {
          recentsScreen.classList.add('hidden');
          recentsScreen.classList.remove('flex');
        }
      }

      renderRecentsStack() {
        const stack = document.getElementById('recents-stack');
        stack.innerHTML = '';

        if (this.appHistory.length === 0) {
          stack.innerHTML = `<div class="text-center text-xs text-slate-500 py-8">No Recent Apps</div>`;
          return;
        }

        this.appHistory.forEach(appId => {
          const appObj = this.installedApps.find(a => a.id === appId) || { name: appId, icon: 'fa-cube' };
          const card = document.createElement('div');
          card.className = 'recents-card m3-glass p-3 rounded-2xl border border-slate-700 flex justify-between items-center cursor-pointer hover:bg-slate-800';
          card.onclick = () => {
            document.getElementById('recents-screen').classList.add('hidden');
            this.openApp(appId);
          };
          card.innerHTML = `
            <div class="flex items-center space-x-3">
              <i class="fa-solid ${appObj.icon} text-indigo-400 text-lg"></i>
              <span class="text-xs font-semibold text-slate-200">${appObj.name}</span>
            </div>
            <button onclick="event.stopPropagation(); VM.removeRecent('${appId}')" class="text-slate-500 hover:text-slate-300">
              <i class="fa-solid fa-xmark"></i>
            </button>
          `;
          stack.appendChild(card);
        });
      }

      removeRecent(appId) {
        this.appHistory = this.appHistory.filter(id => id !== appId);
        this.renderRecentsStack();
      }

      closeAllRecents() {
        this.appHistory = [];
        this.renderRecentsStack();
        this.goHome();
      }

      browserNavigate() {
        if (!this.isOnline) {
          this.showToast('ERR_INTERNET_DISCONNECTED');
          this.log('BROWSER', 'Failed to navigate: Network Offline.', 'warn');
          return;
        }

        const input = document.getElementById('browser-url');
        let url = input.value.trim();
        if (!url.startsWith('http://') && !url.startsWith('https://')) {
          url = 'https://' + url;
          input.value = url;
        }

        const iframe = document.getElementById('browser-iframe');
        const fallback = document.getElementById('browser-fallback');
        const responseData = document.getElementById('browser-response-data');

        this.log('BROWSER', `Navigating to: ${url}`, 'net');

        // Live Fetch test to handle CORS restrictions smoothly in iframe fallback
        fetch(url)
          .then(res => res.text())
          .then(data => {
            iframe.classList.add('hidden');
            fallback.classList.remove('hidden');
            responseData.textContent = data.slice(0, 1000) + (data.length > 1000 ? '\n... [truncated]' : '');
            this.log('BROWSER', `HTTP GET ${url} -> 200 OK`, 'net');
          })
          .catch(err => {
            iframe.classList.add('hidden');
            fallback.classList.remove('hidden');
            responseData.textContent = `// Cross-Origin (CORS) Restricted Webpage or Endpoint Response:\n${err.message}\n\nMirror Request Success: Target reached over Virtual Bridge.`;
            this.log('BROWSER', `Network Response: ${err.message}`, 'info');
          });
      }

      async testApiEndpoint(type) {
        const resultEl = document.getElementById('conn-result');
        const latencyEl = document.getElementById('conn-latency');

        if (!this.isOnline) {
          resultEl.textContent = 'Network Error: Device is currently OFFLINE.\nToggle Network status in top control bar.';
          latencyEl.textContent = '0 ms';
          this.log('NET', 'Connectivity test blocked: Offline mode.', 'warn');
          return;
        }

        resultEl.textContent = 'Executing network request...';
        const start = performance.now();

        try {
          if (type === 'ip') {
            this.log('NET', 'HTTP GET https://api.ipify.org?format=json', 'net');
            const res = await fetch('https://api.ipify.org?format=json');
            const data = await res.json();
            const elapsed = Math.round(performance.now() - start);
            latencyEl.textContent = `${elapsed} ms`;
            resultEl.textContent = JSON.stringify(data, null, 2);
            this.log('NET', `IP response received: ${data.ip}`, 'net');
          } else if (type === 'json') {
            this.log('NET', 'HTTP GET https://jsonplaceholder.typicode.com/todos/1', 'net');
            const res = await fetch('https://jsonplaceholder.typicode.com/todos/1');
            const data = await res.json();
            const elapsed = Math.round(performance.now() - start);
            latencyEl.textContent = `${elapsed} ms`;
            resultEl.textContent = JSON.stringify(data, null, 2);
            this.log('NET', 'JSONPlaceholder API request success.', 'net');
          } else if (type === 'echo') {
            this.log('NET', 'HTTP POST https://httpbin.org/post', 'net');
            const res = await fetch('https://httpbin.org/post', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ vm: 'Android 15', timestamp: Date.now() })
            });
            const data = await res.json();
            const elapsed = Math.round(performance.now() - start);
            latencyEl.textContent = `${elapsed} ms`;
            resultEl.textContent = JSON.stringify(data, null, 2);
            this.log('NET', 'HTTP Echo POST payload success.', 'net');
          } else if (type === 'ping') {
            this.log('NET', 'PING test to cloudflare.com DNS endpoint...', 'net');
            const res = await fetch('https://1.1.1.1', { mode: 'no-cors' });
            const elapsed = Math.round(performance.now() - start);
            latencyEl.textContent = `${elapsed} ms`;
            resultEl.textContent = `Ping Target: 1.1.1.1\nRTT Latency: ${elapsed} ms\nStatus: Reachable`;
            this.log('NET', `Ping latency: ${elapsed} ms`, 'net');
          }
        } catch (err) {
          const elapsed = Math.round(performance.now() - start);
          latencyEl.textContent = `${elapsed} ms`;
          resultEl.textContent = `Connectivity Error:\n${err.message}`;
          this.log('NET', `API Request Failed: ${err.message}`, 'error');
        }
      }

      runCustomApp() {
        const input = document.getElementById('runner-url-input');
        const url = input.value.trim();
        if (!url) return;

        this.log('RUNNER', `Deploying custom Web Package: ${url}`, 'info');
        const container = document.getElementById('view-custom-container');
        container.innerHTML = `<iframe src="${url}" class="w-full h-full rounded-xl border border-slate-800"></iframe>`;
        
        this.openApp('custom-container');
        this.showToast('Custom Package Deployed');
      }

      loadPresetApp(preset) {
        const container = document.getElementById('view-custom-container');
        if (preset === 'calc') {
          container.innerHTML = `
            <div class="p-4 bg-slate-900 rounded-2xl border border-slate-800 max-w-xs mx-auto text-slate-100 font-mono">
              <div id="calc-display" class="bg-slate-950 p-3 rounded-xl text-right text-xl font-bold mb-4 border border-slate-800 text-emerald-400 overflow-x-auto">0</div>
              <div class="grid grid-cols-4 gap-2">
                <button onclick="VM.calcInput('7')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">7</button>
                <button onclick="VM.calcInput('8')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">8</button>
                <button onclick="VM.calcInput('9')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">9</button>
                <button onclick="VM.calcInput('/')" class="p-3 bg-indigo-600 rounded-xl font-bold text-sm">/</button>
                <button onclick="VM.calcInput('4')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">4</button>
                <button onclick="VM.calcInput('5')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">5</button>
                <button onclick="VM.calcInput('6')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">6</button>
                <button onclick="VM.calcInput('*')" class="p-3 bg-indigo-600 rounded-xl font-bold text-sm">*</button>
                <button onclick="VM.calcInput('1')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">1</button>
                <button onclick="VM.calcInput('2')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">2</button>
                <button onclick="VM.calcInput('3')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">3</button>
                <button onclick="VM.calcInput('-')" class="p-3 bg-indigo-600 rounded-xl font-bold text-sm">-</button>
                <button onclick="VM.calcInput('C')" class="p-3 bg-red-800 rounded-xl font-bold text-sm">C</button>
                <button onclick="VM.calcInput('0')" class="p-3 bg-slate-800 rounded-xl font-bold text-sm">0</button>
                <button onclick="VM.calcEval()" class="p-3 bg-emerald-600 col-span-2 rounded-xl font-bold text-sm">=</button>
              </div>
            </div>
          `;
          this.calcExpr = '';
          this.log('RUNNER', 'Loaded Scientific Calc widget.', 'info');
        } else if (preset === 'crypto') {
          container.innerHTML = `
            <div class="p-4 bg-slate-900 rounded-2xl border border-slate-800 space-y-3">
              <h3 class="text-xs font-bold text-slate-300">Live Crypto Ticker (Public API)</h3>
              <div id="crypto-ticker-data" class="text-xs font-mono text-emerald-400">Loading live prices...</div>
            </div>
          `;
          this.fetchCryptoData();
        }
        this.openApp('custom-container');
      }

      calcInput(val) {
        const display = document.getElementById('calc-display');
        if (val === 'C') {
          this.calcExpr = '';
          display.textContent = '0';
        } else {
          this.calcExpr += val;
          display.textContent = this.calcExpr;
        }
      }

      calcEval() {
        const display = document.getElementById('calc-display');
        try {
          const res = eval(this.calcExpr);
          display.textContent = res;
          this.calcExpr = String(res);
        } catch (e) {
          display.textContent = 'Error';
          this.calcExpr = '';
        }
      }

      async fetchCryptoData() {
        const el = document.getElementById('crypto-ticker-data');
        try {
          const res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana&vs_currencies=usd');
          const data = await res.json();
          el.innerHTML = `
            <div class="p-2 bg-slate-950 rounded-lg border border-slate-800 flex justify-between"><span>Bitcoin (BTC):</span> <span class="text-emerald-400">$${data.bitcoin?.usd || 'N/A'}</span></div>
            <div class="p-2 bg-slate-950 rounded-lg border border-slate-800 flex justify-between"><span>Ethereum (ETH):</span> <span class="text-sky-400">$${data.ethereum?.usd || 'N/A'}</span></div>
            <div class="p-2 bg-slate-950 rounded-lg border border-slate-800 flex justify-between"><span>Solana (SOL):</span> <span class="text-purple-400">$${data.solana?.usd || 'N/A'}</span></div>
          `;
          this.log('NET', 'Crypto market prices updated.', 'net');
        } catch (e) {
          el.textContent = 'Error fetching crypto prices or rate limited.';
        }
      }

      loadCustomAppView(appId) {
        const container = document.getElementById('view-custom-container');
        if (appId === 'app_snake') {
          container.innerHTML = `
            <div class="p-4 text-center space-y-3 text-slate-200">
              <i class="fa-solid fa-gamepad text-4xl text-emerald-400"></i>
              <div class="text-xs font-bold">Retro Snake Web Edition</div>
              <p class="text-[10px] text-slate-400">Emulated game runtime active in Android WASM container.</p>
              <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 font-mono text-emerald-400 text-xs">
                [SNAKE GAME ENGINE READY]
              </div>
            </div>
          `;
        }
      }

      clearAppStorage() {
        this.showToast('Storage cache cleared!');
        this.log('SETTINGS', 'Cleared app cache and persistent web storage.', 'info');
      }
    }

    let VM;
    window.onload = () => {
      VM = new AndroidVM();
      VM.init();
    };
  </script>
</body>
</html>
